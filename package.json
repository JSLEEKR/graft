{
  "name": "@graft-lang/graft",
  "version": "3.0.0",
  "description": "Graft compiler — compile .gft graph DSL to Claude Code harness structures",
  "type": "module",
  "license": "MIT",
  "author": "JSLEEKR",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSLEEKR/graft.git"
  },
  "keywords": ["graft", "compiler", "dsl", "llm", "claude", "graph"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ast": {
      "import": "./dist/parser/ast.js",
      "types": "./dist/parser/ast.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "graft": "./dist/index.js",
    "graft-lsp": "./dist/lsp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
