{
  "model": "claude-opus-4-6",
  "permissions": {
    "allow": ["Read", "Write", "Edit", "Bash", "Grep", "Glob", "Agent", "WebSearch", "WebFetch"]
  },
  "harness": {
    "version": "1.0",
    "type": "adversarial-debate",
    "source_spec": "docs/superpowers/specs/2026-03-31-graft-compiler-v1-design.md",
    "source_plan": "docs/superpowers/plans/2026-03-31-graft-compiler-v1.md",
    "agents": {
      "research": ["researcher-arch", "researcher-impl"],
      "debate": ["architect", "pragmatist", "skeptic", "specialist"],
      "convergence": ["convergence"],
      "implementation": ["implementer"],
      "review": ["reviewer"],
      "memory": ["memory-verifier"]
    },
    "process": {
      "steps_per_task": 7,
      "max_review_retries": 2,
      "max_re_debates": 1,
      "forced_dissent": "dynamic_highest_convergence",
      "ratchet_max_unlocks_per_task": 2
    }
  }
}
